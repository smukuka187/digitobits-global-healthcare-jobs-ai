{
  "name": "Payment",
  "type": "object",
  "properties": {
    "subscriptionId": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "pending",
        "refunded"
      ]
    },
    "paymentDate": {
      "type": "string",
      "format": "date-time"
    },
    "stripePaymentId": {
      "type": "string"
    },
    "invoiceUrl": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "plan",
    "amount",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}