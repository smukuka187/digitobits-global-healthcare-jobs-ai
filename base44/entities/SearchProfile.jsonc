{
  "name": "SearchProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profession": {
      "type": "string"
    },
    "jobType": {
      "type": "string"
    },
    "workMode": {
      "type": "string"
    },
    "remoteOnly": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}