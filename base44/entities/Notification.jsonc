{
  "name": "Notification",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "job",
        "application",
        "interview",
        "system"
      ]
    },
    "relatedJobId": {
      "type": "string"
    },
    "read": {
      "type": "boolean"
    }
  },
  "required": [
    "message",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}