{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "professional",
        "premium"
      ]
    },
    "planName": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "past_due",
        "trialing",
        "expired"
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date-time"
    },
    "renewalDate": {
      "type": "string",
      "format": "date"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    },
    "paymentProvider": {
      "type": "string"
    },
    "stripeSubscriptionId": {
      "type": "string"
    },
    "monthlyRecommendationsUsed": {
      "type": "number"
    },
    "monthlyRecommendationsLimit": {
      "type": "number"
    },
    "alertLevel": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "broad"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}